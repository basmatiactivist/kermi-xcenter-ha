{
  "config": {
    "step": {
      "user": {
        "title": "Connect Kermi x-center",
        "description": "Local connection to the x-center web interface. Read-only by default; control must be enabled explicitly in the options.",
        "data": {
          "host": "Host",
          "password": "Password"
        },
        "data_description": {
          "host": "IP address or host name of the x-center, e.g. 192.168.1.50",
          "password": "Password of the x-center web interface"
        }
      },
      "reconfigure": {
        "title": "Change connection",
        "description": "Change the host or password. Leave the password empty to keep the current one.",
        "data": {
          "host": "Host",
          "password": "Password"
        },
        "data_description": {
          "host": "IP address or host name of the x-center, e.g. 192.168.1.50",
          "password": "Password of the x-center web interface"
        }
      },
      "reauth_confirm": {
        "title": "Password rejected",
        "description": "The x-center at {host} rejected the stored password. Enter the current password.",
        "data": {
          "password": "Password"
        },
        "data_description": {
          "password": "Password of the x-center web interface"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the x-center.",
      "invalid_auth": "The x-center rejected the password.",
      "invalid_host": "Enter only an IP address or host name, optionally with :port.",
      "unknown": "Unexpected error."
    },
    "abort": {
      "already_configured": "This x-center is already configured.",
      "reconfigure_successful": "The connection was updated.",
      "reauth_successful": "The password was updated.",
      "wrong_device": "This is a different x-center than the configured one."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "scan_interval": "Poll interval",
          "allow_writes": "Allow control (writes)"
        },
        "data_description": {
          "scan_interval": "Seconds between two reads (minimum 15). The x-center is polled gently; on errors the interval is backed off up to 15 minutes.",
          "allow_writes": "Off by default. Only enable this if you really want Home Assistant to change settings on the heat pump."
        }
      },
      "confirm_writes": {
        "title": "Really allow control?",
        "description": "WARNING: With this option Home Assistant can CHANGE settings on the heat pump: start a one-time hot water charge, set the hot water setpoints (40-55 °C) and switch the energy mode of the heating circuit. Wrong settings can cause discomfort, higher energy costs or legionella risk. The write path has NOT been tested on real hardware. Every write is limited to safe ranges and to one write per value every 5 minutes and is logged. Only confirm if you accept this risk.",
        "data": {
          "confirm_writes": "I understand the risk and want to allow writes"
        }
      }
    },
    "error": {
      "confirm_required": "Please tick the confirmation box, or go back and leave control disabled."
    }
  },
  "exceptions": {
    "invalid_auth": {
      "message": "The x-center rejected the password."
    },
